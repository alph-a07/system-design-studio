#!/bin/sh
# System Design Studio CLI (sds)
# Universal cross-platform command line interface for System Design Studio.
# Works out-of-the-box on macOS, Linux, BSD, and Windows (Git Bash/WSL).

set -e

# Resolve installation or repository directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -d "$SCRIPT_DIR/../skills/system-design-studio/scripts" ]; then
  BASE_SCRIPTS_DIR="$SCRIPT_DIR/../skills/system-design-studio/scripts"
else
  HOME_DIR="${HOME:-$USERPROFILE}"
  GLOBAL_DIR="${SDS_GLOBAL_DIR:-$HOME_DIR/.system-design-studio}"
  BASE_SCRIPTS_DIR="${GLOBAL_DIR}/skills/system-design-studio/scripts"
fi

# Resolve Python 3 executable (handles python3 vs python across Linux/macOS/Windows)
if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
else
  echo "❌ Error: Python 3 is required to run System Design Studio CLI." >&2
  echo "   Please install Python 3 from https://python.org or via your package manager." >&2
  exit 1
fi

INIT_SCRIPT="${BASE_SCRIPTS_DIR}/init-learning-instance.sh"
PROJECTS_SCRIPT="${BASE_SCRIPTS_DIR}/manage-projects.py"
DASHBOARD_SCRIPT="${BASE_SCRIPTS_DIR}/serve-dashboard.py"
CHECKPOINT_SCRIPT="${BASE_SCRIPTS_DIR}/git-checkpoint.py"
CURRICULUM_SCRIPT="${BASE_SCRIPTS_DIR}/configure-curriculum.py"
SETTINGS_SCRIPT="${BASE_SCRIPTS_DIR}/merge-settings.py"
STATUS_SCRIPT="${BASE_SCRIPTS_DIR}/sync-status.py"
REVISIONS_SCRIPT="${BASE_SCRIPTS_DIR}/update-revisions.py"

case "$1" in
  init)
    shift
    exec bash "$INIT_SCRIPT" "$@"
    ;;
  projects|list)
    shift
    exec "$PYTHON_BIN" "$PROJECTS_SCRIPT" list "$@"
    ;;
  switch|open)
    shift
    exec "$PYTHON_BIN" "$PROJECTS_SCRIPT" switch "$@"
    ;;
  notes)
    shift
    exec "$PYTHON_BIN" "$PROJECTS_SCRIPT" notes "$@"
    ;;
  revisions|revision|rev)
    shift
    exec "$PYTHON_BIN" "$REVISIONS_SCRIPT" "$@"
    ;;
  delete|remove|rm)
    shift
    exec "$PYTHON_BIN" "$PROJECTS_SCRIPT" delete "$@"
    ;;
  dashboard|tracker|serve)
    shift
    exec "$PYTHON_BIN" "$DASHBOARD_SCRIPT" "$@"
    ;;
  dummy|demo)
    shift
    DUMMY_DIR=""
    if [ -d "${SCRIPT_DIR}/../dummy-project/.system-design" ]; then
      DUMMY_DIR="${SCRIPT_DIR}/../dummy-project/.system-design"
    elif [ -d "${PWD}/dummy-project/.system-design" ]; then
      DUMMY_DIR="${PWD}/dummy-project/.system-design"
    fi
    if [ -z "$DUMMY_DIR" ] || [ ! -d "$DUMMY_DIR" ]; then
      echo "❌ Error: dummy-project/.system-design not found." >&2
      exit 1
    fi
    echo "🚀 Launching System Design Studio Dashboard for Dummy Project..."
    exec "$PYTHON_BIN" "$DASHBOARD_SCRIPT" --instance-dir "$DUMMY_DIR" "$@"
    ;;
  rollback|restore|undo)
    shift
    exec "$PYTHON_BIN" "$CHECKPOINT_SCRIPT" rollback "$@"
    ;;
  checkpoints)
    shift
    exec "$PYTHON_BIN" "$CHECKPOINT_SCRIPT" list "$@"
    ;;
  curriculum)
    shift
    exec "$PYTHON_BIN" "$CURRICULUM_SCRIPT" "$@"
    ;;
  config)
    shift
    exec "$PYTHON_BIN" "$SETTINGS_SCRIPT" "$@"
    ;;
  status)
    shift
    exec "$PYTHON_BIN" "$STATUS_SCRIPT" "$@"
    ;;
  update|upgrade)
    shift
    UPDATE_SCRIPT=""
    if [ -f "$SCRIPT_DIR/../update.sh" ]; then
      UPDATE_SCRIPT="$SCRIPT_DIR/../update.sh"
    elif [ -f "${GLOBAL_DIR}/update.sh" ]; then
      UPDATE_SCRIPT="${GLOBAL_DIR}/update.sh"
    elif [ -f "${BASE_SCRIPTS_DIR}/update.sh" ]; then
      UPDATE_SCRIPT="${BASE_SCRIPTS_DIR}/update.sh"
    fi
    if [ -n "$UPDATE_SCRIPT" ] && [ -f "$UPDATE_SCRIPT" ]; then
      exec bash "$UPDATE_SCRIPT" "$@"
    else
      echo "📥 Downloading latest update engine..."
      exec curl -fsSL https://raw.githubusercontent.com/alph-a07/system-design-studio/main/update.sh | bash
    fi
    ;;
  version|-v|--version)
    echo "System Design Studio CLI v3.4.0"
    ;;
  help|-h|--help|*)
    echo "============================================================================"
    echo "  SYSTEM DESIGN STUDIO CLI (sds) — v3.4.0"
    echo "============================================================================"
    echo "Usage: sds <command> [options]"
    echo ""
    echo "Core Commands:"
    echo "  sds init [options]         Initialize or scaffold a project learning instance"
    echo "  sds dashboard [options]    Launch interactive curriculum studio & workbench on localhost"
    echo "  sds dummy [options]        Launch dashboard for local dummy test project"
    echo "  sds revisions [options]    Review high-yield invariants & trade-off defenses"
    echo "  sds list / projects        List registered projects, tracks, and progress"
    echo "  sds switch <id>            Switch active project context"
    echo "  sds notes [id]             List generated study notes for active project"
    echo "  sds delete <id>            Safely delete a project instance"
    echo ""
    echo "State & Safety:"
    echo "  sds rollback [--steps N]   Roll back state to a previous atomic checkpoint"
    echo "  sds checkpoints            List recent state snapshots and Git commits"
    echo "  sds curriculum [options]   Configure, prune, or reorder curriculum tracks"
    echo "  sds config [key] [val]     Inspect or dynamically update settings"
    echo "  sds status                 Display current living cursor and topic metrics"
    echo "  sds update                 Update studio skills to the latest release"
    echo "  sds version                Print version information"
    echo "============================================================================"
    ;;
esac
